{"no":80,"ad":"Abese","arapcaAd":"عبس","yer":"Mekke","ayetSayisi":42,"besmele":true,"ayetler":[{"n":1,"ar":"عَبَسَ وَتَوَلَّىٰٓ","tr":"(Peygamber) Yüzünü ekşitti ve döndü."},{"n":2,"ar":"أَن جَآءَهُ ٱلْأَعْمَىٰ","tr":"Kendisine âmâ geldi, diye."},{"n":3,"ar":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tr":"Ne bilirsin, belki o temizlenecek?"},{"n":4,"ar":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","tr":"Veya öğüt belleyecek de öğüt ona fayda verecek."},{"n":5,"ar":"أَمَّا مَنِ ٱسْتَغْنَىٰ","tr":"Ama buna ihtiyaç hissetmeyene gelince,"},{"n":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tr":"Sen ona yöneliyorsun."},{"n":7,"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","tr":"Onun temizlenmemesinden sana ne?"},{"n":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","tr":"Ama sana can atarak gelen,"},{"n":9,"ar":"وَهُوَ يَخْشَىٰ","tr":"Allah'tan korkarak gelmişken,"},{"n":10,"ar":"فَأَنتَ عَنْهُ تَلَهَّىٰ","tr":"Sen onunla ilgilenmiyorsun."},{"n":11,"ar":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","tr":"Hayır hayır, sakın. Çünkü o Kur'ân bir öğüttür."},{"n":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tr":"Artık dileyen onu düşünür."},{"n":13,"ar":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","tr":"O, değerli sahifelerdedir."},{"n":14,"ar":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","tr":"Yüksek tutulan tertemiz sahifelerde."},{"n":15,"ar":"بِأَيْدِى سَفَرَةٍۢ","tr":"Yazıcıların ellerindedir,"},{"n":16,"ar":"كِرَامٍۭ بَرَرَةٍۢ","tr":"Değerli, iyi yazıcıların."},{"n":17,"ar":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","tr":"O kahrolası insan, ne nankör şey."},{"n":18,"ar":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","tr":"O yaratan onu hangi şeyden yarattı?"},{"n":19,"ar":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tr":"Bir damla sudan, onu yarattı da biçime koydu."},{"n":20,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tr":"Sonra ona yolunu kolaylaştırdı."},{"n":21,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","tr":"Sonra onu öldürdü de kabre koydurdu."},{"n":22,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tr":"Sonra dilediği vakit onu tekrar diriltir."},{"n":23,"ar":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","tr":"Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi,"},{"n":24,"ar":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","tr":"Bir de o insan yiyeceğine baksın."},{"n":25,"ar":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","tr":"Biz o suyu bol bol döktük."},{"n":26,"ar":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","tr":"Sonra toprağı nasıl da yardık."},{"n":27,"ar":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","tr":"Bu suretle orada ekinler bitirdik."},{"n":28,"ar":"وَعِنَبًۭا وَقَضْبًۭا","tr":"Üzümler, yoncalar,"},{"n":29,"ar":"وَزَيْتُونًۭا وَنَخْلًۭا","tr":"Zeytinlikler, hurmalıklar,"},{"n":30,"ar":"وَحَدَآئِقَ غُلْبًۭا","tr":"İri ve sık ağaçlı bahçeler,"},{"n":31,"ar":"وَفَٰكِهَةًۭ وَأَبًّۭا","tr":"Meyveler, çayırlar bitirdik."},{"n":32,"ar":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","tr":"Siz ve hayvanlarınız faydalansın diye."},{"n":33,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tr":"Kulakları sağır eden o gürültü geldiğinde,"},{"n":34,"ar":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","tr":"O gün kişi kaçar, kardeşinden..."},{"n":35,"ar":"وَأُمِّهِۦ وَأَبِيهِ","tr":"Anasından, babasından.."},{"n":36,"ar":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","tr":"Eşinden ve oğullarından."},{"n":37,"ar":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","tr":"Onlardan her birinin o gün başından aşan işi vardır."},{"n":38,"ar":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","tr":"Yüzler var ki, o gün parıl parıl,"},{"n":39,"ar":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","tr":"Güler, sevinir."},{"n":40,"ar":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","tr":"Yüzler de var ki, o gün tozlanmış,"},{"n":41,"ar":"تَرْهَقُهَا قَتَرَةٌ","tr":"Onları karanlık bürümüş,"},{"n":42,"ar":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","tr":"İşte onlardır kâfirler, haktan sapanlar."}]}