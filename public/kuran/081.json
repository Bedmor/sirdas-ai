{"no":81,"ad":"Tekvir","arapcaAd":"التكوير","yer":"Mekke","ayetSayisi":29,"besmele":true,"ayetler":[{"n":1,"ar":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","tr":"Güneş katlanıp dürüldüğünde,"},{"n":2,"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","tr":"Yıldızlar bulandığında,"},{"n":3,"ar":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","tr":"Dağlar yürütüldüğünde,"},{"n":4,"ar":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","tr":"Kıyılmaz mallar bırakıldığında,"},{"n":5,"ar":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","tr":"Vahşi hayvanlar bir araya toplandığında,"},{"n":6,"ar":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","tr":"Denizler ateşlendiğinde (suları çekilip, volkanlar halinde ateş püskürdüğünde),"},{"n":7,"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","tr":"Nefisler eşleştirildiğinde (iyiler iyilerle, kötüler kötülerle bir araya toplandığında),"},{"n":8,"ar":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","tr":"Diri diri toprağa gömülen kıza sorulduğunda,"},{"n":9,"ar":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","tr":"\"Hangi günahtan dolayı öldürüldü?\" diye."},{"n":10,"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","tr":"Amel defterleri açıldığında,"},{"n":11,"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","tr":"Gök sıyrılıp açıldığında,"},{"n":12,"ar":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","tr":"Cehennem kızıştırıldığında,"},{"n":13,"ar":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","tr":"Ve cennet yaklaştırıldığında,"},{"n":14,"ar":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","tr":"Herkes ne getirmiş olduğunu anlar."},{"n":15,"ar":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","tr":"Şimdi yemin ederim o sinenlere (gündüzleri gözden kaybolan yıldızlara),"},{"n":16,"ar":"ٱلْجَوَارِ ٱلْكُنَّسِ","tr":"O akıp akıp yuvasına gidenlere,"},{"n":17,"ar":"وَٱلَّيْلِ إِذَا عَسْعَسَ","tr":"Yöneldiği an geceye,"},{"n":18,"ar":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","tr":"Nefeslendiği (ağardığı) an sabaha ki,"},{"n":19,"ar":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","tr":"Kuşkusuz o Kur'an, değerli bir elçinin sözüdür."},{"n":20,"ar":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","tr":"O elçi güçlüdür, Arş'ın sahibinin yanında çok itibarlıdır."},{"n":21,"ar":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","tr":"Orada ona itaat edilir, güvenilir."},{"n":22,"ar":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","tr":"Arkadaşınızı cin çarpmış değildir."},{"n":23,"ar":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","tr":"Andolsun o, Cebrail'i açık ufukta gördü."},{"n":24,"ar":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","tr":"O, gayb hakkında cimri de değildir."},{"n":25,"ar":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","tr":"O, kovulmuş bir şeytanın sözü değildir."},{"n":26,"ar":"فَأَيْنَ تَذْهَبُونَ","tr":"Hâl böyle iken, siz nereye gidiyorsunuz?"},{"n":27,"ar":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","tr":"O, âlemler için öğütten başka bir şey değildir,"},{"n":28,"ar":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","tr":"İçinizden doğru gitmek isteyenler için."},{"n":29,"ar":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","tr":"Âlemlerin Rabbi olan Allah dilemeyince, siz dileyemezsiniz."}]}