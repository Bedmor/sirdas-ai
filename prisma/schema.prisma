enum TonePreference {
  SEFKATLI_TESKIN
  DIRILIS_VE_GAYRET
  NET_VE_MUALLIM
  HIKMETLI_SUKUT
  TAVIZSIZ_MUALLIM
}

enum SpiritualStage {
  ARAYIS_VE_BASLANGIC
  DARLIK_VE_BUNALIM
  DERINLESMIS_SALIK
  ISTIKAMET_VE_INSA
  MUHASEBE_VE_TEVBE
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  phoneNumber         String       @unique @map("phone_number")
  onboardingStep      Int          @default(1) @map("onboarding_step")
  onboardingCompleted Boolean      @default(false) @map("onboarding_completed")

  // 4 Bloklu Dijital İkiz Künyesi:
  // {
  //   "roles": ["EVLI", "IKI_COCUK", "ESNAF", "HASTA_BAKIMI"],
  //   "spiritual_trials": ["RIZIK_KAYGISI", "ANI_OFKE", "ELALEM_NE_DER"],
  //   "biological_energy": ["SABAH_ZOR_UYANMA", "KRONIK_YORGUNLUK"],
  //   "tone_preference": "SEFKATLI_TESKIN" | "DIRILIS_VE_GAYRET" | "NET_VE_MUALLIM" | "HIKMETLI_SUKUT" | "TAVIZSIZ_MUALLIM",
  //   "spiritual_stage": "ARAYIS_VE_BASLANGIC" | "DARLIK_VE_BUNALIM" | "DERINLESMIS_SALIK" | "ISTIKAMET_VE_INSA" | "MUHASEBE_VE_TEVBE"
  // }
  profileMetadata     Json         @default("{}") @map("profile_metadata")

  createdAt           DateTime     @default(now()) @map("created_at")
  lastActiveAt        DateTime     @default(now()) @map("last_active_at")

  messages            Message[]

  @@index([phoneNumber])
  @@map("users")
}

model KnowledgeChunk {
  id             String      @id @default(uuid()) @db.Uuid
  sourceType     SourceType  @map("source_type")
  sourceTitle    String      @map("source_title")
  content        String      @db.Text
  tags           String[]    @default([])
  nafsTraps      String[]    @default([]) @map("nafs_traps")
  isRibaRelated  Boolean     @default(false) @map("is_riba_related")

  // Ses Kesiti Metadata (Halis Aydemir Sohbetleri İçin)
  youtubeId      String?     @map("youtube_id")
  startSec       Float?      @map("start_sec")
  endSec         Float?      @map("end_sec")
  audioUrl       String?     @map("audio_url") // Cloudflare R2 linki (.ogg)

  // pgvector alanı Prisma'da Unsupported olarak tanımlanır, SQL RPC ile aranır
  embedding      Unsupported("vector(768)")?

  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([tags], type: Gin)
  @@index([nafsTraps], type: Gin)
  @@index([sourceType])
  @@index([isRibaRelated])
  @@map("knowledge_chunks")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  // Meta Webhook mükerrer mesaj (retry storm) engelleme kilidi
  waMessageId     String?     @unique @map("wa_message_id")

  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String      @db.Text

  // RAG İzlenebilirlik Kayıtları
  ragChunkIds     String[]    @default([]) @map("rag_chunk_ids")

  // Jev (System 1) Karar Metadata'sı
  // {
  //   "noul": { "is_fatwa": 0.05, "is_riba": 0.85, "needs_audio": 0.90 },
  //   "choice": { "nafs_trap": "FAKIRLIK_KORKUSU_VESVESESI", "rag_category": "RIZIK_VE_TICARET", "tone_preference": "SEFKATLI_TESKIN", "spiritual_stage": "DARLIK_VE_BUNALIM" },
  //   "score": { "distress_level": 7 }
  // }
  jevMetadata     Json?       @map("jev_metadata")

  // Gemini 2.5 Flash İçsel Editör Denetim Logu
  // {
  //   "murakabe_applied": true,
  //   "ilahi_riza_checked": true,
  //   "tevekkul_and_talak_hope_included": true,
  //   "nafs_and_vesvese_addressed": "...",
  //   "siyer_example_used": "...",
  //   "riba_warning_included": true
  // }
  editorAudit     Json?       @map("editor_audit")

  // Gönderilen Ses Dosyası
  audioSent       Boolean     @default(false) @map("audio_sent")
  audioUrlSent    String?     @map("audio_url_sent")

  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([waMessageId])
  @@map("messages")
}

model Donation {
  id                    String         @id @default(uuid()) @db.Uuid
  donorName             String?        @map("donor_name")
  donorPhone            String?        @map("donor_phone")
  amount                Decimal        @db.Decimal(10, 2)
  currency              String         @default("TRY")
  paymentProvider       String         @map("payment_provider") // "PAYTR" | "IYZICO"
  providerTransactionId String?        @unique @map("provider_transaction_id")
  status                DonationStatus @default(PENDING)
  createdAt             DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("donations")
}

// ---------------------------------------------------------------------------
// DUA HAVUZU (Adnan Bey 13.11): isimsiz, kategorisiz kısa dua istekleri.
// - Yazanın kimliği saklanmaz; yalnız cihaz kimliğinin tek yönlü özeti tutulur.
// - Metin, kişisel bilgiler gizlendikten sonra yazılır (ham metin saklanmaz).
// - İstek 3 gün sonra listeden düşer (bitis_tarihi ile süzülür).
// ---------------------------------------------------------------------------
model DuaIstegi {
  id               String       @id @default(uuid()) @db.Uuid
  metin            String       @db.Text
  sahipKimlikOzeti String       @map("sahip_kimlik_ozeti") @db.VarChar(64)
  olusturmaTarihi  DateTime     @default(now()) @map("olusturma_tarihi")
  bitisTarihi      DateTime     @map("bitis_tarihi")

  destekler        DuaDestegi[]

  @@index([bitisTarihi, olusturmaTarihi])
  @@index([sahipKimlikOzeti, olusturmaTarihi])
  @@map("dua_istekleri")
}

// "Allah yardımcın olsun" basışları: her cihaz bir isteğe yalnız bir kez basabilir.
model DuaDestegi {
  id              String    @id @default(uuid()) @db.Uuid
  duaIstegiId     String    @map("dua_istegi_id") @db.Uuid
  duaIstegi       DuaIstegi @relation(fields: [duaIstegiId], references: [id], onDelete: Cascade)
  kimlikOzeti     String    @map("kimlik_ozeti") @db.VarChar(64)
  olusturmaTarihi DateTime  @default(now()) @map("olusturma_tarihi")

  @@unique([duaIstegiId, kimlikOzeti])
  @@map("dua_destekleri")
}
