{"no":93,"ad":"Duhâ","arapcaAd":"الضحى","yer":"Mekke","ayetSayisi":11,"besmele":true,"ayetler":[{"n":1,"ar":"وَٱلضُّحَىٰ","tr":"Andolsun kuşluk vaktine."},{"n":2,"ar":"وَٱلَّيْلِ إِذَا سَجَىٰ","tr":"Ve sakinleştiği zaman geceye ki,"},{"n":3,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","tr":"Rabbin seni bırakmadı ve darılmadı."},{"n":4,"ar":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","tr":"Ahiret senin için dünyadan iyi olacaktır."},{"n":5,"ar":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","tr":"Rabbın sana verecek ve sen hoşnut olacaksın."},{"n":6,"ar":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","tr":"O seni yetim bulup da barındırmadı mı?"},{"n":7,"ar":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","tr":"Seni yol bilmez bulup yola iletmedi mi?"},{"n":8,"ar":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","tr":"Seni yoksul bulup zengin etmedi mi?"},{"n":9,"ar":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","tr":"Öyleyse sakın yetimi ezme."},{"n":10,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","tr":"Dilenciyi de azarlama."},{"n":11,"ar":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","tr":"Fakat Rabbinin nimetini anlat da anlat."}]}