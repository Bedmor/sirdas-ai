# ==============================================================================
# SIRDAŞ AI - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyayı .env olarak kopyalayın ve gerçek anahtarlarınızı girin.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERİTABANI & PRISMA (SUPABASE POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
# Prisma bağlantı URL'si (Supabase Transaction Pooler - Port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma Migration ve Direct URL (Supabase Session Pooler veya Direct DB - Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & RPC İSTEMCİSİ
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 SES DEPOLAMA (S3 UYUMLU, 0 EGRESS ÜCRETİ)
# ------------------------------------------------------------------------------
# Cloudflare Dashboard -> R2 -> Overview -> Account ID
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="sirdas-audio"
# S3 Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
# Özel alan adı veya R2 public bucket URL'si (.ogg ses dosyaları için)
R2_PUBLIC_BASE_URL="https://media.sirdas.ai"

# ------------------------------------------------------------------------------
# 4. BİLİŞSEL ÇEKİRDEK (SYSTEM 1 JEV + SYSTEM 2 GEMINI 2.5 FLASH)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Jev TypeSafe decisions + Gemini 2.5 Flash gateway)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_DECISIONS_MODEL="typesafe/jev-1.14"

# Doğrudan TypeSafe AI API (https://typesafe.ai / @typesafe-ai/sdk)
TYPESAFE_API_KEY="jv_live_..."
TYPESAFE_BASE_URL="https://api.typesafe.ai"

# Google AI Studio API Key (text-embedding-004 ve doğrudan Gemini 2.5 Flash için)
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 5. ÖDEME ALTYAPISI (ASKIDA SIRDAŞ - PAYTR / IYZICO)
# ------------------------------------------------------------------------------
PAYTR_MERCHANT_ID="your-paytr-merchant-id"
PAYTR_MERCHANT_KEY="your-paytr-merchant-key"
PAYTR_MERCHANT_SALT="your-paytr-merchant-salt"

IYZICO_API_KEY="your-iyzico-api-key"
IYZICO_SECRET_KEY="your-iyzico-secret-key"
IYZICO_BASE_URL="https://api.iyzipay.com"

# ------------------------------------------------------------------------------
# 6. UYGULAMA & GENEL AYARLAR
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 7. DUA HAVUZU
# ------------------------------------------------------------------------------
# "bellek" yazılırsa dua havuzu veri tabanı yerine bellek içi sahte depoyla çalışır
# (yerel deneme için; DATABASE_URL tanımlı değilse de otomatik bellek kullanılır).
DUA_HAVUZU_DEPO=
# Cihaz kimliği özetinde kullanılan gizli tuz (boş bırakılırsa sabit varsayılan kullanılır)
DUA_HAVUZU_TUZ=
