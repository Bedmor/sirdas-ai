{"no":112,"ad":"İhlâs","arapcaAd":"الإخلاص","yer":"Mekke","ayetSayisi":4,"besmele":true,"ayetler":[{"n":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","tr":"De ki; O Allah bir tektir."},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allah eksiksiz, sameddir (Bütün varlıklar O'na muhtaç, fakat O, hiç bir şeye muhtaç değildir"},{"n":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tr":"Doğurmadı ve doğurulmadı"},{"n":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tr":"O 'na bir denk de olmadı."}]}