{"no":100,"ad":"Âdiyât","arapcaAd":"العاديات","yer":"Mekke","ayetSayisi":11,"besmele":true,"ayetler":[{"n":1,"ar":"وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","tr":"O harıl harıl (savaşa) koşanlara,"},{"n":2,"ar":"فَٱلْمُورِيَٰتِ قَدْحًۭا","tr":"(Tırnaklarıyla yerden) ateş çıkaranlara,"},{"n":3,"ar":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","tr":"Sabahleyin akın edenlere,"},{"n":4,"ar":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","tr":"Tozu dumana karıştıranlara,"},{"n":5,"ar":"فَوَسَطْنَ بِهِۦ جَمْعًا","tr":"Derken bir topluluğun ortasına dalanlara yemin ederim ki,"},{"n":6,"ar":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","tr":"Şüphesiz insan, Rabbine karşı çok nankördür."},{"n":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","tr":"Ve kendisi de buna şahittir."},{"n":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","tr":"Gerçekten o dünya malını çok sevdiği için katıdır."},{"n":9,"ar":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","tr":"Bilmiyor mu ki, kabirlerin içindekiler fırlatılacak."},{"n":10,"ar":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","tr":"Ve sinelerin içindekiler derlenecek."},{"n":11,"ar":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","tr":"O gün Rableri onların bütün yaptıklarından haberdardır"}]}