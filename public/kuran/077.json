{"no":77,"ad":"Mürselât","arapcaAd":"المرسلات","yer":"Mekke","ayetSayisi":50,"besmele":true,"ayetler":[{"n":1,"ar":"وَٱلْمُرْسَلَٰتِ عُرْفًۭا","tr":"Andolsun birbiri ardınca gönderilenlere,"},{"n":2,"ar":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","tr":"Büküp devirenlere,"},{"n":3,"ar":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","tr":"Yaydıkça yayanlara,"},{"n":4,"ar":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","tr":"Seçip ayıranlara,"},{"n":5,"ar":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","tr":"Bir öğüt bırakanlara,"},{"n":6,"ar":"عُذْرًا أَوْ نُذْرًا","tr":"Gerek özür için olsun, gerek uyarı için,"},{"n":7,"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","tr":"Herhalde size vaad olunan kesinlikle olacaktır."},{"n":8,"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","tr":"Hani o yıldızlar silindiği zaman,"},{"n":9,"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","tr":"Gök yarıldığı zaman,"},{"n":10,"ar":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","tr":"Dağlar savrulduğu zaman,"},{"n":11,"ar":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","tr":"Elçiler, tayin edilen vakitlerine erdirildikleri zaman,"},{"n":12,"ar":"لِأَىِّ يَوْمٍ أُجِّلَتْ","tr":"Bunlar hangi güne ertelendiler?"},{"n":13,"ar":"لِيَوْمِ ٱلْفَصْلِ","tr":"Hüküm gününe.."},{"n":14,"ar":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","tr":"Bildin mi, nedir o hüküm günü?"},{"n":15,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":16,"ar":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","tr":"Biz, öncekileri helak etmedik mi?"},{"n":17,"ar":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","tr":"Sonra geridekileri de onlara katarız."},{"n":18,"ar":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","tr":"Biz suçlulara böyle yaparız."},{"n":19,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vah haline!"},{"n":20,"ar":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","tr":"Biz sizi âdi bir sudan yaratmadık mı?"},{"n":21,"ar":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","tr":"Onu sağlam bir yerde oturttuk."},{"n":22,"ar":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","tr":"Belli bir süreye kadar."},{"n":23,"ar":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","tr":"Demek ki biçimlendirmişiz. Ne güzel biçimlendireniz biz."},{"n":24,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":25,"ar":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","tr":"Yeryüzünü bir tokat (toplanma yeri) yapmadık mı?"},{"n":26,"ar":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","tr":"Gerek diriler, gerekse ölüler için."},{"n":27,"ar":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","tr":"Orada yüksek yüksek dağlar oturtup da size bir tatlı su sunmadık mı?"},{"n":28,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":29,"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","tr":"(Kıyameti yalanlayanlara şöyle denir): \"Haydin gidin o yalanladığınız şeye doğru.\""},{"n":30,"ar":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","tr":"\"Haydi gidin o üç çatallı gölgeye (cehenneme).\""},{"n":31,"ar":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","tr":"O, ne gölgelendirir, ne alevden korur."},{"n":32,"ar":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","tr":"O, saray gibi kıvılcımlar atar."},{"n":33,"ar":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","tr":"Sanki o kıvılcımlar, sarı sarı (erkek deve sürüleridir)."},{"n":34,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":35,"ar":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","tr":"Bugün, konuşamıyacakları gündür."},{"n":36,"ar":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","tr":"Kendilerine izin de verilmez ki, özür beyan etsinler."},{"n":37,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":38,"ar":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","tr":"Bu, işte o hüküm günüdür. Sizi ve öncekileri bir araya topladık."},{"n":39,"ar":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","tr":"Bir hileniz varsa beni atlatın."},{"n":40,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":41,"ar":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","tr":"Kuşkusuz takva sahipleri gölgeler altında ve pınar başlarındadır."},{"n":42,"ar":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","tr":"Canlarının çektiğinden türlü meyveler arasındadırlar."},{"n":43,"ar":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","tr":"(Onlara): \"Yaptıklarınıza karşılık afiyetle yiyin, için\" (denir)."},{"n":44,"ar":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","tr":"İşte biz güzel amel işleyenleri böyle mükafatlandırırız."},{"n":45,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":46,"ar":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","tr":"Yiyin, zevklenin biraz, çünkü siz suçlularsınız."},{"n":47,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"O gün yalanlayanların vay haline!"},{"n":48,"ar":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","tr":"Onlara: \"Rüku edin\" denildiği zaman etmezler."},{"n":49,"ar":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","tr":"Vay haline o gün yalanlayanların!"},{"n":50,"ar":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","tr":"Artık bundan (Kur'an'dan) sonra hangi söze inanacaklar?"}]}