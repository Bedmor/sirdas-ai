{"no":88,"ad":"Gâşiye","arapcaAd":"الغاشية","yer":"Mekke","ayetSayisi":26,"besmele":true,"ayetler":[{"n":1,"ar":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","tr":"O her şeyi kuşatacak olan Kıyamet'in haberi sana geldi mi?"},{"n":2,"ar":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","tr":"Yüzler var ki, o gün eğilmiş, zillete düşmüştür."},{"n":3,"ar":"عَامِلَةٌۭ نَّاصِبَةٌۭ","tr":"Çalışmış, yorulmuştur."},{"n":4,"ar":"تَصْلَىٰ نَارًا حَامِيَةًۭ","tr":"Kızışmış bir ateşe girer."},{"n":5,"ar":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","tr":"Onlara kızgın bir kaynaktan su verilir."},{"n":6,"ar":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","tr":"Onlar için kuru bir dikenden başka yiyecek de yoktur."},{"n":7,"ar":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","tr":"O da ne besler, ne de açlığı giderir."},{"n":8,"ar":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","tr":"Yüzler de var ki, o gün nimetle mutludur."},{"n":9,"ar":"لِّسَعْيِهَا رَاضِيَةٌۭ","tr":"Yaptığından hoşnuttur."},{"n":10,"ar":"فِى جَنَّةٍ عَالِيَةٍۢ","tr":"Yüksek bir cennettedir."},{"n":11,"ar":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","tr":"Orada boş bir söz işitmez."},{"n":12,"ar":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","tr":"Orada akan bir kaynak,"},{"n":13,"ar":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","tr":"Yükseltilmiş divanlar,"},{"n":14,"ar":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","tr":"Konulmuş kadehler,"},{"n":15,"ar":"وَنَمَارِقُ مَصْفُوفَةٌۭ","tr":"Dizilmiş koltuklar, yastıklar,"},{"n":16,"ar":"وَزَرَابِىُّ مَبْثُوثَةٌ","tr":"Serilmiş halılar vardır."},{"n":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","tr":"Bakmıyorlar mı o develere, nasıl yaratılmış?"},{"n":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","tr":"Göğe bakmıyorlar mı, nasıl yükseltilmiş?"},{"n":19,"ar":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","tr":"Bakmıyorlar mı dağlara, nasıl dikilmiş?"},{"n":20,"ar":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","tr":"Yere bakmıyorlar mı, nasıl yayılmış?"},{"n":21,"ar":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","tr":"Haydi öğüt ver; sen şimdi sırf bir öğütçüsün."},{"n":22,"ar":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","tr":"Onların üzerinde bir zorba değilsin."},{"n":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tr":"Ancak kim yüz çevirir ve kâfir olursa,"},{"n":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","tr":"Allah ona en büyük azap ile azap edecek."},{"n":25,"ar":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","tr":"Kuşkusuz onlar döne dolaşa bize gelecekler."},{"n":26,"ar":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","tr":"Sonra da bize hesap verecekler."}]}