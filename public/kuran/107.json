{"no":107,"ad":"Mâûn","arapcaAd":"الماعون","yer":"Mekke","ayetSayisi":7,"besmele":true,"ayetler":[{"n":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tr":"Dini yalanlayanı gördün mü?"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tr":"İşte o, öksüzü iter, kakar."},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tr":"Yoksulu doyurmaya önayak olmaz."},{"n":4,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","tr":"Vay haline o namaz kılanların ki,"},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tr":"Kıldıkları namazın değerine aldırış etmezler."},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tr":"Gösteriş yaparlar onlar,"},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tr":"Ve yardımlığı sakınırlar (zekatı vermezler)."}]}