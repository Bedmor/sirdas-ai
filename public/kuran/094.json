{"no":94,"ad":"İnşirâh","arapcaAd":"الشرح","yer":"Mekke","ayetSayisi":8,"besmele":true,"ayetler":[{"n":1,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tr":"Biz senin için (mutluluğun) göğsünü açmadık mı?"},{"n":2,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tr":"Senden yükünü indirmedik mi?"},{"n":3,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tr":"O senin sırtını ezen yükü."},{"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tr":"Senin şanını yüceltmedik mi?"},{"n":5,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tr":"Demek ki, zorlukla beraber bir kolaylık vardır."},{"n":6,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","tr":"Evet, zorlukla beraber bir kolaylık vardır."},{"n":7,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tr":"O halde boş kaldın mı, yine kalk (başka bir iş ve ibadetle) yorul."},{"n":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tr":"Ancak Rabbine yönel."}]}