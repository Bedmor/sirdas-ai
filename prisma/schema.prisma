datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
}

enum SourceType {
  QURAN
  HADITH
  DUA
  HALIS_AYDEMIR
  SIYER
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

