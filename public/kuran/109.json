{"no":109,"ad":"Kâfirûn","arapcaAd":"الكافرون","yer":"Mekke","ayetSayisi":6,"besmele":true,"ayetler":[{"n":1,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tr":"De ki: Ey kâfirler"},{"n":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"Sizin taptıklarınıza ben tapmam."},{"n":3,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"Siz de benim taptığıma tapıcılar değilsiniz."},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","tr":"Ben asla sizin taptıklarınıza tapacak değilim."},{"n":5,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"Siz de benim taptığıma tapacak değilsiniz."},{"n":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"Sizin dininiz size, benim dinim banadır."}]}