{"no":105,"ad":"Fil","arapcaAd":"الفيل","yer":"Mekke","ayetSayisi":5,"besmele":true,"ayetler":[{"n":1,"ar":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","tr":"Görmedin mi Rabb'in fil sahiplerine ne yaptı?"},{"n":2,"ar":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","tr":"Onların tuzaklarını boşa çıkarmadı mı?"},{"n":3,"ar":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","tr":"Üzerlerine sürü sürü kuşlar gönderdi."},{"n":4,"ar":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","tr":"Onlara çamurdan sertleşmiş taşlar atıyorlardı."},{"n":5,"ar":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","tr":"Ve onları, yenilmiş ekin yaprağı gibi yaptı."}]}