{"no":114,"ad":"Nâs","arapcaAd":"الناس","yer":"Mekke","ayetSayisi":6,"besmele":true,"ayetler":[{"n":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"De ki: Sığınırım ben insanların Rabbine,"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"İnsanların hükümdârına,"},{"n":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"İnsanların ilâhına,"},{"n":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tr":"O sinsi vesvesecinin şerrinden."},{"n":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tr":"O ki, insanların göğüslerine vesveseler fısıldar."},{"n":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tr":"Gerek cinlerden, gerek insanlardan."}]}